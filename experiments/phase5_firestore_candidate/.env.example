# Documentation only. Do not put a service-account key in this file.
STORAGE_BACKEND=sqlite
SQLITE_PATH=./data/candidate.sqlite
SOURCE_LINEAGE_ID=candidate-local
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_ALLOW_REMOTE=false
FIRESTORE_ALLOW_WRITES=false
# For an explicitly approved local emulator test only:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_PROJECT_ID=demo-thermocast-phase5
# SOURCE_LINEAGE_ID=synthetic-staging-v1
# Existing Render credentials remain server-side; never copy the secret file:
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/<existing-service-account-file>.json
MODEL_PATH=./lnn_heat_index_model.pth
DEVICE_AUTH_MODE=off
DEVICE_AUTH_TOKEN=
